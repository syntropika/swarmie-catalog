{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "integration": {
      "additionalProperties": false,
      "properties": {
        "reviewed_on": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
        },
        "routes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "auth_methods": {
                "items": {
                  "enum": [
                    "oauth",
                    "account-login",
                    "api-key",
                    "github-token"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "automation": {
                "enum": [
                  "supported",
                  "restricted",
                  "unknown"
                ],
                "type": "string"
              },
              "billing": {
                "enum": [
                  "subscription",
                  "usage-based",
                  "byok",
                  "unknown"
                ],
                "type": "string"
              },
              "connection_kind": {
                "enum": [
                  "subscription",
                  "api-key",
                  "coding-agent",
                  "unknown"
                ],
                "type": "string"
              },
              "constraints": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "endpoints": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "protocols": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "region": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "protocols"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "evidence": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "execution": {
                "enum": [
                  "direct-model",
                  "coding-agent",
                  "unknown"
                ],
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "direct-api",
                  "cli",
                  "sdk"
                ],
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "products": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "protocols": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "required_clients": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "support": {
                "enum": [
                  "documented",
                  "not-supported",
                  "unknown"
                ],
                "type": "string"
              },
              "third_party_use": {
                "enum": [
                  "supported",
                  "restricted",
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "execution",
              "billing",
              "connection_kind",
              "products",
              "support",
              "auth_methods",
              "required_clients",
              "protocols",
              "endpoints",
              "third_party_use",
              "automation",
              "constraints",
              "evidence"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "capture_kind": {
                "enum": [
                  "http-body",
                  "web-extract"
                ],
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "id",
              "url",
              "sha256",
              "capture_kind"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "reviewed_on",
        "sources",
        "routes"
      ],
      "type": "object"
    },
    "model_catalog": {
      "additionalProperties": false,
      "properties": {
        "products": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "anyOf": [
                  {
                    "enum": [
                      "current",
                      "stale"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "partial",
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "state"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "enum": [
            "partial",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "products"
      ],
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "additionalProperties": {},
        "properties": {
          "canonical_model_id": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "subscription_access": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "enum": [
                    "subscription",
                    "api"
                  ],
                  "type": "string"
                },
                "error": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "locator": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "source": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "locator"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "minimum_client_version": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model_id": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "plans": {
                  "items": {
                    "anyOf": [
                      {
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "product": {
                  "minLength": 1,
                  "type": "string"
                },
                "provider": {
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "source_model": {
                  "minLength": 1,
                  "type": "string"
                },
                "source_updated_at": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "current",
                    "stale"
                  ],
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "available",
                    "unavailable",
                    "unknown"
                  ],
                  "type": "string"
                },
                "subscription": {
                  "minLength": 1,
                  "type": "string"
                },
                "surface": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "variant": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "product",
                "provider",
                "source_model",
                "model_id",
                "channel",
                "surface",
                "variant",
                "minimum_client_version",
                "status",
                "reason",
                "evidence",
                "subscription",
                "plans",
                "state",
                "source_updated_at",
                "error"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "subscription_access"
        ],
        "type": "object"
      },
      "propertyNames": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "products": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "subscription_catalog": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "type": "number"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "modified_at": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                "type": "string"
              },
              "revision": {
                "pattern": "^[a-f0-9]{40}$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "id",
              "url",
              "revision",
              "sha256",
              "modified_at"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "upstream": {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "url": {
              "const": "https://models.dev/catalog.json?type=all",
              "type": "string"
            }
          },
          "required": [
            "url",
            "sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "upstream",
        "sources"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "name",
    "products",
    "integration",
    "model_catalog",
    "models",
    "subscription_catalog"
  ],
  "type": "object"
}
