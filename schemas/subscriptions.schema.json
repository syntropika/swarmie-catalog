{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "subscriptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "integration": {
            "additionalProperties": false,
            "properties": {
              "reviewed_on": {
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "type": "string"
              },
              "routes": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "auth_methods": {
                      "items": {
                        "enum": [
                          "oauth",
                          "account-login",
                          "api-key",
                          "github-token"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "automation": {
                      "enum": [
                        "supported",
                        "restricted",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "billing": {
                      "enum": [
                        "subscription",
                        "usage-based",
                        "byok",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "connection_kind": {
                      "enum": [
                        "subscription",
                        "api-key",
                        "coding-agent",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "constraints": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "endpoints": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "protocols": {
                            "items": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "minItems": 1,
                            "type": "array"
                          },
                          "region": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "url": {
                            "format": "uri",
                            "type": "string"
                          }
                        },
                        "required": [
                          "url",
                          "protocols"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "evidence": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "execution": {
                      "enum": [
                        "direct-model",
                        "coding-agent",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "direct-api",
                        "cli",
                        "sdk"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "products": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "protocols": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "required_clients": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "support": {
                      "enum": [
                        "documented",
                        "not-supported",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "third_party_use": {
                      "enum": [
                        "supported",
                        "restricted",
                        "unknown"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "execution",
                    "billing",
                    "connection_kind",
                    "products",
                    "support",
                    "auth_methods",
                    "required_clients",
                    "protocols",
                    "endpoints",
                    "third_party_use",
                    "automation",
                    "constraints",
                    "evidence"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "sources": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "capture_kind": {
                      "enum": [
                        "http-body",
                        "web-extract"
                      ],
                      "type": "string"
                    },
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "url",
                    "sha256",
                    "capture_kind"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "reviewed_on",
              "sources",
              "routes"
            ],
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "products": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "products",
          "integration"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "subscriptions"
  ],
  "type": "object"
}
