{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "enum": [
                    "subscription",
                    "api"
                  ],
                  "type": "string"
                },
                "evidence": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "locator": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "source": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "locator"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "minimum_client_version": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model_id": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "plan": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "product": {
                  "minLength": 1,
                  "type": "string"
                },
                "provider": {
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "source_model": {
                  "minLength": 1,
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "available",
                    "unavailable",
                    "unknown"
                  ],
                  "type": "string"
                },
                "surface": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "variant": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "product",
                "provider",
                "source_model",
                "model_id",
                "channel",
                "plan",
                "surface",
                "variant",
                "minimum_client_version",
                "status",
                "reason",
                "evidence"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "source_updated_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "type": "string"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "modified_at": {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
                  "type": "string"
                },
                "revision": {
                  "pattern": "^[a-f0-9]{40}$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "url": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "url",
                "revision",
                "sha256",
                "modified_at"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "state": {
            "enum": [
              "current",
              "stale"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "error",
          "source_updated_at",
          "sources",
          "claims"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "upstream": {
      "const": "https://models.dev/catalog.json?type=all",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "upstream",
    "providers"
  ],
  "type": "object"
}
